{
  "name": "easyjobapplied",
  "version": "1.0.0",
  "description": "Smart Curated Company Job Links & Application Tracker with SQLite Database",
  "scripts": {
    "dev": "concurrently -k -n \"backend,frontend\" -c \"cyan.bold,magenta.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "start": "npm run dev",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "build": "cd frontend && npm run build"
  },
  "keywords": [
    "job-tracker",
    "company-links",
    "applications",
    "interviews",
    "sqlite"
  ],
  "author": "Hiramani Chauhan",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
